package templates

import "github.com/felipefbs/portfolio/portfolio"

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="pt-BR" class="scroll-smooth">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link href="/static/styles/output.css" rel="stylesheet"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			<title>{ "felipefbs - " + title }</title>
		</head>
		<body class="bg-background text-text-secondary font-['Inter'] antialiased min-h-screen">
			{ children... }
		</body>
	</html>
}

templ Home(
	educationList []*portfolio.EducationItemProps,
	xpList []*portfolio.JobExperienceItemProps,
	projectList []*portfolio.ProjectItemProps,
) {
	@Base("Portfolio") {
		@Header("")
		<main class="max-w-4xl mx-auto px-6 pt-24">
			<section id="about" class="py-12">
				@AboutContent(educationList)
			</section>

			<div class="border-t border-border"></div>

			<section id="experience" class="py-12">
				<h2 class="text-2xl font-semibold text-text-primary mb-8">Experiências Profissionais</h2>
				<div class="space-y-6">
					for _, xp := range xpList {
						@ExperienceItem(xp)
					}
				</div>
			</section>

			<div class="border-t border-border"></div>

			<section id="projects" class="py-12">
				<h2 class="text-2xl font-semibold text-text-primary mb-8">Projetos</h2>
				<div class="grid gap-6 md:grid-cols-2">
					for _, project := range projectList {
						@ProjectItem(project)
					}
				</div>
			</section>
		</main>
	}
}
