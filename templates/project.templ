package templates

import "github.com/felipefbs/portfolio/portfolio"

templ ProjectItem(item *portfolio.ProjectItemProps) {
	<article class="p-6 bg-zinc-900/50 rounded-xl border border-zinc-800 hover:border-zinc-700 transition-all hover:shadow-lg hover:shadow-emerald-900/10 flex flex-col">
		<div class="mb-4">
			<span class="text-xs font-medium text-emerald-400 uppercase tracking-wider">{ item.Type }</span>
			<h3 class="text-lg font-semibold text-zinc-100 mt-1">{ item.Title }</h3>
		</div>

		<div class="mb-4 flex flex-wrap gap-2">
			for _, lang := range item.Languages {
				<span class="px-2 py-1 bg-zinc-800 text-zinc-300 text-xs rounded">{ lang }</span>
			}
			for _, tech := range item.Technologies {
				<span class="px-2 py-1 bg-zinc-800/50 text-zinc-400 text-xs rounded">{ tech }</span>
			}
		</div>

		<ul class="space-y-2 mb-4 flex-1">
			for _, desc := range item.Description {
				<li class="text-zinc-400 text-sm flex gap-2">
					<span class="text-emerald-400">▸</span>
					{ desc }
				</li>
			}
		</ul>

		<a
			href={ templ.URL(item.RepositoryLink) }
			target="_blank"
			class="inline-flex items-center gap-2 text-emerald-400 hover:text-emerald-300 text-sm font-medium mt-auto"
		>
			Ver código →
		</a>
	</article>
}
