package templates

import "github.com/felipefbs/portfolio/portfolio"

templ ProjectItem(item *portfolio.ProjectItemProps) {
	<article class="p-6 bg-background-muted rounded-xl border border-border hover:border-border-hover transition-all hover:shadow-lg hover:shadow-accent-shadow flex flex-col">
		<div class="mb-4">
			<span class="text-xs font-medium text-accent uppercase tracking-wider">{ item.Type }</span>
			<h3 class="text-lg font-semibold text-text-primary mt-1">{ item.Title }</h3>
		</div>

		<div class="mb-4 flex flex-wrap gap-2">
			for _, lang := range item.Languages {
				<span class="px-2 py-1 bg-border text-text-secondary text-xs rounded">{ lang }</span>
			}
			for _, tech := range item.Technologies {
				<span class="px-2 py-1 bg-border/50 text-text-muted text-xs rounded">{ tech }</span>
			}
		</div>

		<ul class="space-y-2 mb-4 flex-1">
			for _, desc := range item.Description {
				<li class="text-text-muted text-sm flex gap-2">
					<span class="text-accent">▸</span>
					{ desc }
				</li>
			}
		</ul>

		<a
			href={ templ.URL(item.RepositoryLink) }
			target="_blank"
			class="inline-flex items-center gap-2 text-accent hover:text-accent-hover text-sm font-medium mt-auto"
		>
			Ver código →
		</a>
	</article>
}
