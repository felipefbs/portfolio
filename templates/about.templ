package templates

import "github.com/felipefbs/portfolio/portfolio"

templ AboutContent(educationList []*portfolio.EducationItemProps) {
	<section class="mb-16">
		<div class="flex flex-col md:flex-row gap-8 items-start">
			<img
				src="/static/images/felipe_ferreira.jpeg"
				alt="Felipe Ferreira"
				class="w-32 h-32 rounded-2xl object-cover shadow-lg"
			/>
			<div>
				<h1 class="text-4xl font-bold text-text-primary mb-2">Felipe Ferreira</h1>
				<p class="text-accent font-medium mb-4">Desenvolvedor Backend</p>
				<div class="flex gap-4">
					@SocialIcon("https://github.com/felipefbs", "GitHub")
					@SocialIcon("https://linkedin.com/in/felipefbs", "LinkedIn")
				</div>
			</div>
		</div>
	</section>

	<section class="mb-16">
		<p class="text-lg text-text-muted leading-relaxed">
			Desenvolvedor Backend com foco em Go e arquitetura de microsserviços.
			Experiência com metodologias ágeis, TDD e modelagem de domínio.
			Graduado em Telemática pelo IFPB.
		</p>
	</section>

	<section>
		<h2 class="text-xl font-semibold text-text-primary mb-6">Formação</h2>
		<div class="space-y-4">
			for _, item := range educationList {
				@Education(item)
			}
		</div>
	</section>
}

templ SocialIcon(url, name string) {
	<a
		href={ templ.SafeURL(url) }
		target="_blank"
		class="px-4 py-2 bg-background hover:bg-border text-text-secondary hover:text-text-primary rounded-lg text-sm font-medium transition-colors border border-border hover:border-border-hover"
	>
		{ name }
	</a>
}

templ Education(item *portfolio.EducationItemProps) {
	<div class="p-4 bg-background-muted rounded-lg border border-border hover:border-border-hover transition-colors">
		<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
			<div>
				<span class="text-xs font-medium text-accent uppercase tracking-wider">{ item.Type }</span>
				<h3 class="text-text-primary font-semibold">{ item.Title }</h3>
				<a href={ templ.URL(item.OrganizationLink) } target="_blank" class="text-text-muted hover:text-text-secondary text-sm">
					{ item.Organization }
				</a>
			</div>
			<div class="text-right">
				<span class="text-text-subtle text-sm">{ item.Duration }</span>
				<p class="text-text-subtle text-sm">{ item.Location }</p>
			</div>
		</div>
	</div>
}
