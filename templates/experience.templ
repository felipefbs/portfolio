package templates

import "github.com/felipefbs/portfolio/portfolio"

templ ExperienceItem(item *portfolio.JobExperienceItemProps) {
	<article class="p-6 bg-background-muted rounded-xl border border-border hover:border-border-hover transition-all hover:shadow-lg hover:shadow-accent-shadow">
		<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
			<div>
				<h3 class="text-xl font-semibold text-text-primary">{ item.JobTitle }</h3>
				<a href={ templ.URL(item.OrganizationLink) } target="_blank" class="text-accent hover:text-accent-hover font-medium">
					{ item.Organization }
				</a>
				<p class="text-text-subtle text-sm mt-1">{ item.Location }</p>
			</div>
			<span class="text-sm text-text-muted bg-border px-3 py-1 rounded-full">
				{ item.Duration }
			</span>
		</div>

		<div class="mb-4">
			<p class="text-xs font-medium text-text-subtle uppercase tracking-wider mb-2">Stack</p>
			<div class="flex flex-wrap gap-2">
				for _, lang := range item.Languages {
					<span class="px-2 py-1 bg-border text-text-secondary text-xs rounded">{ lang }</span>
				}
				for _, tech := range item.Technologies {
					<span class="px-2 py-1 bg-border/50 text-text-muted text-xs rounded">{ tech }</span>
				}
			</div>
		</div>

		if len(item.Responsibilities) > 0 {
			<ul class="space-y-2">
				for _, resp := range item.Responsibilities {
					<li class="text-text-muted text-sm flex gap-2">
						<span class="text-accent">▸</span>
						{ resp }
					</li>
				}
			</ul>
		}
	</article>
}
